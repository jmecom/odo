FINDING_SCHEMA["properties"]["behavior_change"] = {
    "type": "string", "enum": ["none", "nondefault", "unknown"]}
FINDING_SCHEMA["properties"]["id"] = {"type": "string", "pattern": f"^{FINDING_ID_PATTERN}$"}
